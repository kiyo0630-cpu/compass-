{
  "name": "compass-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "コンパス手帳 / 日本へのサイバー攻撃マップ / e-card などを同居させた GitHub Pages リポジトリのルート。テストと Lint の入口。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:py": "ruff check keiba",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "globals": "^16.4.0"
  }
}
